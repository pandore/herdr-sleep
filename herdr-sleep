CONFIG_KEYS = {"idle_hours": (int, float), "poll_seconds": int, "exclude_cwds": list, "brief_dirs": list,
               "summary_model": str, "user_name": str}


def read_config() -> tuple[dict, str | None]:
    """(settings, error). A bad file disables sleeping: an exclusion we cannot read must not be ignored."""
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except FileNotFoundError:
        return {}, None
    except (OSError, ValueError) as exc:
        return {}, f"{CONFIG_PATH}: {exc}"
    if not isinstance(cfg, dict):
        return {}, f"{CONFIG_PATH}: not a JSON object"
    bad = [k for k, v in cfg.items() if k not in CONFIG_KEYS or isinstance(v, bool) or not isinstance(v, CONFIG_KEYS[k])
           or (isinstance(v, list) and not all(isinstance(x, str) for x in v))]
    return ({}, f"{CONFIG_PATH}: bad or unknown keys {bad}") if bad else (cfg, None)


