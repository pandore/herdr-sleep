# --- Herdr and processes -------------------------------------------------------------------

def herdr(*args: str, check: bool = True) -> dict | None:
    proc = subprocess.run([os.environ.get("HERDR_BIN_PATH", "herdr"), *args],
                          capture_output=True, text=True, timeout=30)
    if proc.returncode != 0:
        if check:
            raise RuntimeError(f"herdr {' '.join(args[:2])}: {proc.stderr.strip()[:300]}")
        return None
    try:
        return json.loads(proc.stdout).get("result") or {}
    except ValueError:
        return {}


def screen(pane: str) -> str | None:
    proc = subprocess.run([os.environ.get("HERDR_BIN_PATH", "herdr"), "pane", "read", pane,
                           "--source", "visible", "--format", "ansi"], capture_output=True, timeout=30)
    return proc.stdout.decode("utf-8", "replace") if proc.returncode == 0 else None


def agents_now() -> list[dict]:
    return herdr("agent", "list")["agents"]


def session_of(agent: dict) -> str:
    return (agent.get("agent_session") or {}).get("value") or ""


def ps_table() -> dict[int, tuple[int, str]]:
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True, timeout=10).stdout
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            procs[int(parts[0])] = (int(parts[1]), parts[2])
    return procs


def tree_rss_mb(pid: int, procs: dict[int, tuple[int, str]]) -> int:
    pids, todo = [], [pid]
    while todo:
        p = todo.pop()
        pids.append(str(p))
        todo += [c for c, (pp, _) in procs.items() if pp == p]
    out = subprocess.run(["ps", "-o", "rss=", "-p", ",".join(pids)], capture_output=True, text=True).stdout
    return sum(int(x) for x in out.split() if x.isdigit()) // 1024


def busy_children(pid: int, procs: dict[int, tuple[int, str]]) -> list[str]:
    """Children of the agent that are not MCP or language servers: a background command still running."""
    busy = []
    for _child, (ppid, cmd) in procs.items():
        if ppid != pid or cmd == "<defunct>":
            continue
        base = os.path.basename(cmd.split()[0]) if cmd.split() else ""
        server = bool(set(re.split(r"[^a-z0-9]+", cmd.lower())) & SERVER_WORDS) or base in SERVERS or "language-server" in cmd
        if "shell-snapshots" in cmd or not server:  # a Bash tool command runs through a shell snapshot
            busy.append(cmd[:80])
    return busy


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


# --- Claude transcripts --------------------------------------------------------------------

def transcript(sid: str) -> Path | None:
    hits = glob.glob(str(PROJECTS / "*" / f"{sid}.jsonl")) if UUID.match(sid) else []
    return Path(hits[0]) if len(hits) == 1 else None


def project_dir_name(cwd: str) -> str:
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def synthetic(d: dict) -> bool:
    """Entries nobody typed: meta, subagent turns, and the 'session is being continued' compaction summary."""
    return bool(d.get("isMeta") or d.get("isSidechain") or d.get("isCompactSummary") or d.get("isVisibleInTranscriptOnly"))


def messages(path: Path) -> list[tuple[str, str]]:
    """(role, text) of the real turns, oldest first: no tool calls, tool results, meta or command echoes."""
    out = []
    with open(path, errors="replace") as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            role = d.get("type")
            if role not in ("user", "assistant") or synthetic(d):
                continue
            content = (d.get("message") or {}).get("content")
            if isinstance(content, str):
                parts = [content]
            elif isinstance(content, list):
                parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
            else:
                continue
            text = "\n".join(p for p in parts if p).strip()
            if text and not text.startswith(("<command-", "<local-command", "<system-reminder", "<bash-",
                                             "<task-notification", "Caveat:")):
                out.append((role, text))
    return out


def last_turn_age_hours(path: Path) -> float | None:
    """Hours since the last user or assistant entry. Not the file's mtime: Claude appends bookkeeping to quiet sessions."""
    size = path.stat().st_size
    for start in (max(0, size - 4_000_000), 0):  # the tail is enough unless the last turn sits far back
        latest = ""
        with open(path, "rb") as f:
            f.seek(start)
            for raw in f:
                if b'"timestamp"' not in raw or not (b'"type":"user"' in raw or b'"type":"assistant"' in raw):
                    continue
                try:
                    d = json.loads(raw)
                except ValueError:
                    continue
                if d.get("type") in ("user", "assistant") and isinstance(d.get("timestamp"), str):
                    latest = max(latest, d["timestamp"])
        if latest:
            when = datetime.fromisoformat(latest.replace("Z", "+00:00"))
            return (datetime.now(when.tzinfo) - when).total_seconds() / 3600
        if start == 0:
            return None
    return None


def last_permission_mode(path: Path) -> str:
    mode = b""
    with open(path, "rb") as f:
        for raw in f:
            for found in re.findall(rb'"permissionMode":"([A-Za-z]+)"', raw):
                mode = found
    return mode.decode()


def with_mode(argv: list[str], mode: str) -> list[str]:
    """Resume in the permission mode the session had before sleep, bypass included."""
    cli = MODES.get(mode)
    if not cli or (cli == "bypassPermissions" and not set(argv) & BYPASS_ENABLERS):
        return argv  # unknown mode, or bypass Claude would refuse: the settings default applies
    out, i = [], 0
    while i < len(argv):
        if argv[i] == "--permission-mode":
            i += 2
            continue
        if not argv[i].startswith("--permission-mode="):
            out.append(argv[i])
        i += 1
    return out + ["--permission-mode", cli]


def last_recap(path: Path) -> str:
    recap = ""
    with open(path, errors="replace") as f:
        for line in f:
            if '"away_summary"' in line:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("subtype") == "away_summary":
                    recap = d.get("content") or ""
    return re.sub(r"\s*\(disable recaps in /config\)\s*$", "", recap).strip()


def tail_entries(path: Path, size: int = 4_000_000) -> list[dict]:
    out = []
    with open(path, "rb") as f:
        f.seek(max(0, path.stat().st_size - size))
        for raw in f:
            try:
                d = json.loads(raw)
            except ValueError:
                continue  # also the line the seek cut in half
            if isinstance(d, dict):
                out.append(d)
    return out


def short_path(p: str, cwd: str) -> str:
    if "/.claude/projects/" in p and "/memory/" in p:
        return "пам'ять агента"
    if p.startswith(("/private/tmp/", "/tmp/")):
        return "чернетка " + os.path.basename(p)
    root = cwd.rstrip("/") + "/"
    return p[len(root):] if p.startswith(root) else p.replace(os.path.expanduser("~"), "~", 1)


SKIP_TOOLS = {"ToolSearch", "TodoWrite", "TaskStop", "TaskOutput", "BashOutput", "KillShell", "ArtifactData",
              "ScheduleWakeup", "Monitor"}
VERBS = {"edit": "змінено ", "write": "створено ", "read": "переглянуто "}  # runs of these merge into one line


def action_of(block: dict, cwd: str) -> tuple[str, str, str] | None:
    """(kind, symbol, text) for one tool call; None for bookkeeping nobody needs to see."""
    name = block.get("name") or ""
    i = block.get("input") if isinstance(block.get("input"), dict) else {}
    if name in SKIP_TOOLS:
        return None
    if name in ("Edit", "MultiEdit", "NotebookEdit"):
        return "edit", "✎", short_path(str(i.get("file_path") or i.get("notebook_path") or ""), cwd)
    if name == "Write":
        return "write", "✚", short_path(str(i.get("file_path") or ""), cwd)
    if name in ("Read", "Grep", "Glob", "LS"):
        return "read", "◦", short_path(str(i.get("file_path") or i.get("path") or i.get("pattern") or ""), cwd)
    if name == "Bash":
        return "bash", "▸", str(i.get("description") or str(i.get("command") or "").split("\n")[0])
    if name == "AskUserQuestion":
        q = (i.get("questions") or [{}])[0]
        return "ask", "?", "питання тобі: " + str(q.get("question", "") if isinstance(q, dict) else "")
    if name in ("Agent", "Task"):
        return "agent", "⇢", "субагент: " + str(i.get("description") or "")
    if name == "SendMessage":
        to = str(i.get("to") or "")
        return "agent", "⇢", "повідомлення агенту" + (f" {to}" if re.match(r"^[\w.-]+$", to) else "")  # not a socket path
    if name == "WebSearch":
        return "web", "⌕", "пошук: " + str(i.get("query") or "")
    if name == "WebFetch":
        return "web", "⌕", urlparse(str(i.get("url") or "")).netloc
    if name.startswith("mcp__"):
        parts = name.split("__", 2) + ["", ""]
        return "tool", "⚙", f"{parts[1]}: {parts[2]}"
    return "tool", "⚙", name


def recent_actions(path: Path, cwd: str, limit: int = 8) -> list[dict]:
    """The session's last actions, oldest first: your messages and the agent's tool calls, runs merged."""
    items: list[dict] = []
    for d in tail_entries(path):
        content = (d.get("message") or {}).get("content")
        try:
            when = datetime.fromisoformat(str(d.get("timestamp")).replace("Z", "+00:00")).astimezone()
        except ValueError:
            continue
        found = []
        if synthetic(d):
            continue
        if d.get("type") == "user":
            parts = [content] if isinstance(content, str) else \
                [b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text"]
            text = " ".join(" ".join(parts).split())
            if text and not text.startswith(("<", "Caveat:", "[Request interrupted")):
                found.append(("you", "›", f"ти: «{text}»"))
        elif d.get("type") == "assistant" and isinstance(content, list):
            found = [a for a in (action_of(b, cwd) for b in content
                                 if isinstance(b, dict) and b.get("type") == "tool_use") if a]
        for kind, sym, text in found:
            last = items[-1] if items else None
            if last and last["kind"] == kind and kind in VERBS:
                if text not in last["targets"]:
                    last["targets"].append(text)
            elif last and last["kind"] == kind and last["targets"] == [text]:
                last["n"] += 1
            else:
                items.append({"when": when, "kind": kind, "sym": sym, "targets": [text], "n": 1})
    return items[-limit:]


def summarize(msgs: list[tuple[str, str]], tab: str, cwd: str) -> str:
    tail, size = [], 0
    for role, text in reversed(msgs):
        chunk = f"{'Користувач' if role == 'user' else 'Агент'}: {text[:3000]}"
        if size + len(chunk) > 30000:
            break
        tail.append(chunk)
        size += len(chunk)
    if not tail:
        return ""
    return haiku(PROMPT.format(tab=tab, cwd=cwd) + "\n\n<розмова>\n" + "\n\n".join(reversed(tail)) + "\n</розмова>")


def project_material(msgs: list[tuple[str, str]], cwd: str) -> str:
    """The brief the agent started from (a .md named in its first messages, from the briefs folder or the
    project), else its first message, plus the project's own instructions."""
    parts, first = [], [t for r, t in msgs if r == "user"][:3]
    for text in first:
        for ref in re.findall(r"((?:~|/)[^\s\"'«»`<>]+\.md)", text):
            path = os.path.realpath(os.path.expanduser(ref))
            if os.path.isfile(path) and any(path.startswith(root + "/") for root in (*BRIEF_DIRS, cwd)):
                parts.append(f"Бриф ({os.path.basename(path)}):\n" + Path(path).read_text(errors="replace")[:6000])
                break
        if parts:
            break
    if not parts and first:
        parts.append("Перше повідомлення:\n" + first[0][:3000])
    for name in ("CLAUDE.md", "AGENTS.md", "README.md"):
        doc = Path(cwd) / name
        if doc.is_file():
            parts.append(f"{name}:\n" + doc.read_text(errors="replace")[:4000])
            break
    return "\n\n".join(parts)


def project_context(msgs: list[tuple[str, str]], cwd: str, place: str) -> str:
    material = project_material(msgs, cwd)
    if not material:
        return ""
    return haiku(PROJECT_PROMPT.format(place=place, cwd=cwd) + "\n\n<матеріали>\n" + material + "\n</матеріали>")


def haiku(prompt: str) -> str:
    if not SUMMARY_MODEL:
        return ""
    # A nested claude must not report itself to Herdr as this pane's session, nor run the user's hooks.
    env = {k: v for k, v in os.environ.items() if not k.startswith(("HERDR_", "CLAUDECODE", "CLAUDE_CODE_"))}
    claude = shutil.which("claude", path=env.get("PATH")) or os.path.expanduser("~/.local/bin/claude")
    try:
        proc = subprocess.run([claude, "-p", "--model", SUMMARY_MODEL, "--no-session-persistence",
                               "--strict-mcp-config", "--tools", "", "--settings", '{"disableAllHooks": true}'],
                              input=prompt, capture_output=True, text=True, timeout=180, cwd=str(STATE), env=env)
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"haiku failed: {exc}")
        return ""
    if proc.returncode != 0:
        log(f"haiku failed: {proc.stderr.strip()[:300]}")
        return ""
    return proc.stdout.strip()


# --- Decisions -----------------------------------------------------------------------------

def replay_argv(argv: list[str] | None) -> tuple[list[str] | None, str | None]:
    """The launch argv without its session selection, or (None, why) when replaying it is unsafe."""
    if not argv:
        return None, "launch argv unknown"
    out, i = [argv[0]], 1
    while i < len(argv):
        a = argv[i]
        base = a.split("=", 1)[0]
        if a == "--" or base in REFUSED_FLAGS:
            return None, f"argv has {a}"
        if base in ("--resume", "-r"):
            has_value = "=" not in a and i + 1 < len(argv) and not argv[i + 1].startswith("-")
            i += 2 if has_value else 1
        elif a in ("--continue", "-c"):
            i += 1
        elif a in BOOL_FLAGS:
            out.append(a)
            i += 1
        elif base in VALUE_FLAGS:
            if "=" in a:
                out.append(a)
                i += 1
            elif i + 1 < len(argv):
                out += argv[i:i + 2]
                i += 2
            else:
                return None, f"{a} has no value"
        elif base in LIST_FLAGS:
            out.append(a)
            i += 1
            while "=" not in a and i < len(argv) and not argv[i].startswith("-"):
                out.append(argv[i])
                i += 1
        elif a.startswith("-"):
            return None, f"unknown option {a}"
        else:
            return None, "argv has a prompt"
    return out, None


def composer_state(text: str | None) -> str:
    """'empty' | 'draft' | 'unknown' from the ANSI screen. Dim text is Claude's suggestion, not the user's draft."""
    if not text:
        return "unknown"
    lines = text.splitlines()
    plain = [ANSI.sub("", ln).strip() for ln in lines]
    for i in range(len(lines) - 1, 0, -1):
        if plain[i].startswith("❯"):
            end = next((j for j in range(i + 1, len(lines)) if RULE.match(plain[j])), None)
            if end is None or not RULE.match(plain[i - 1]):
                return "unknown"
            body = re.sub(r"\x1b\[2m[^\x1b]*", "", "\n".join(lines[i:end]))
            rest = ANSI.sub("", body).replace("❯", "", 1).replace("\xa0", " ").strip()
            return "draft" if rest else "empty"
    return "unknown"


def screen_mode(text: str | None) -> str:
    """The permission mode in Claude's footer, below the composer. The transcript records a switch only with
    the next message, so the screen is the live answer; '' when the footer shows no mode we know."""
    plain = [ANSI.sub("", ln).strip() for ln in (text or "").splitlines()]
    rules = [i for i, ln in enumerate(plain) if RULE.match(ln)]
    footer = " ".join(plain[rules[-1] + 1:]) if rules else ""
    return next((mode for phrase, mode in FOOTER_MODES.items() if phrase in footer), "")


def why_awake(a: dict, agents: list[dict], tabs: dict, manual: bool = False) -> tuple[str | None, dict | None]:
    """(reason, None) when the agent stays awake, else (None, what sleeping it needs). Fails closed."""
    if a.get("agent") != "claude":
        return "not claude", None
    status = a.get("agent_status")
    if status not in ("idle", "done"):
        return f"status {status}", None
    tab = tabs.get(a.get("tab_id")) or {}
    if not manual and (a.get("focused") or tab.get("focused")):
        return "focused", None
    cwd = os.path.realpath(a.get("foreground_cwd") or a.get("cwd") or "/")
    if cwd in EXCLUDE_CWDS:
        return "excluded", None
    sid = session_of(a)
    path = transcript(sid)
    if not path:
        return "no session id or transcript", None
    if path.parent.name != project_dir_name(cwd):
        return "transcript belongs to another folder", None
    if sum(1 for x in agents if session_of(x) == sid) != 1:
        return "session open in another pane", None
    quiet = last_turn_age_hours(path)
    if quiet is None:
        return "no conversation turns yet", None
    if not manual and quiet < IDLE_HOURS:
        return f"quiet {quiet:.1f} h", None
    info = (herdr("pane", "process-info", "--pane", a["pane_id"], check=False) or {}).get("process_info") or {}
    claudes = [p for p in info.get("foreground_processes") or []
               if os.path.basename((p.get("argv") or [""])[0]) == "claude"]
    if len(claudes) != 1:
        return "claude process not identified", None
    pid = claudes[0]["pid"]
    procs = ps_table()
    parent = procs.get(procs.get(pid, (0, ""))[0], (0, ""))[1].split()
    if not parent or os.path.basename(parent[0]).lstrip("-") not in SHELLS:
        return "claude is not a child of the pane shell", None
    argv, err = replay_argv(claudes[0].get("argv"))
    if err:
        return err, None
    busy = busy_children(pid, procs)
    if busy:
        return f"background command: {busy[0]}", None
    text = screen(a["pane_id"])
    state = composer_state(text)
    if state != "empty":
        return f"composer {state}", None
    return None, {"pid": pid, "argv": argv, "sid": sid, "cwd": cwd, "transcript": path, "tab": tab,
                  "quiet": quiet, "rss": tree_rss_mb(pid, procs), "mode": screen_mode(text)}


# --- State ---------------------------------------------------------------------------------

def log(msg: str) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "sleep.log", "a") as f:
        f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")


@contextmanager
def locked(name: str = "journal"):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / f"{name}.lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def load() -> dict:
    try:
        data = json.loads(JOURNAL.read_text())
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict):
        raise RuntimeError(f"{JOURNAL} is not a JSON object")
    return data


def save(data: dict) -> None:
    tmp = JOURNAL.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1))
    tmp.replace(JOURNAL)


def resume_line(rec: dict, sid: str) -> str:
    return f"cd {shlex.quote(rec['cwd'])} && {shlex.join(rec['argv'] + ['--resume', sid])}"


def claim(pane: str, rec: dict) -> None:
    """Keep a sidebar row for the slept pane: Herdr drops the agent row when claude exits."""
    herdr("pane", "report-agent", pane, "--source", SOURCE, "--agent", LABEL, "--state", "idle",
          "--message", f"спить з {rec['slept_at']}", check=False)
    herdr("pane", "report-metadata", pane, "--source", SOURCE, "--agent", LABEL,
          "--display-agent", f"{MARK}{rec.get('name') or 'claude'}", "--state-label", "idle=спить", check=False)


def unclaim(pane: str) -> None:
    herdr("pane", "release-agent", pane, "--source", SOURCE, "--agent", LABEL, check=False)
    herdr("pane", "report-metadata", pane, "--source", SOURCE, "--clear-display-agent",
          "--clear-state-labels", check=False)


def mark_tab(tab_id: str) -> None:
    label = ((herdr("tab", "get", tab_id, check=False) or {}).get("tab") or {}).get("label") or ""
    if label and not label.startswith(MARK):
        herdr("tab", "rename", tab_id, MARK + label, check=False)


def unmark_tab(tab_id: str, data: dict, sid: str) -> None:
    if any(r.get("tab_id") == tab_id for s, r in data.items() if s != sid):
        return  # another pane in this tab still sleeps
    label = ((herdr("tab", "get", tab_id, check=False) or {}).get("tab") or {}).get("label") or ""
    if label.startswith(MARK):
        herdr("tab", "rename", tab_id, label[len(MARK):], check=False)


def place_of(workspace_id: str | None, tab_label: str) -> str:
    """'Особисте / LinkedIn': where the tab lives, for the page."""
    spaces = {w.get("workspace_id"): w.get("label") for w in
              (herdr("workspace", "list", check=False) or {}).get("workspaces", [])}
    tab = tab_label[len(MARK):] if tab_label.startswith(MARK) else tab_label
    return " / ".join(x for x in (spaces.get(workspace_id) or "", tab) if x)


def show_page(pane: str, sid: str) -> None:
    herdr("pane", "run", pane, f" {shlex.quote(SELF)} page {sid}")  # leading space: kept out of shell history


# --- Sleep ---------------------------------------------------------------------------------

def sleep_pane(a: dict, agents: list[dict], tabs: dict, manual: bool = False) -> str | None:
    """Sleep one agent. Returns why it stayed awake, or None once it sleeps."""
    reason, f = why_awake(a, agents, tabs, manual)
    if reason:
        return reason
    pane, sid = a["pane_id"], f["sid"]
    msgs = messages(f["transcript"])
    place = place_of(a.get("workspace_id"), f["tab"].get("label") or "")
    summary = summarize(msgs, f["tab"].get("label") or "", f["cwd"]) or last_recap(f["transcript"])
    project = project_context(msgs, f["cwd"], place)
    # Re-check everything: the summary took a while and the user may have come back.
    fresh = next((x for x in agents_now() if x.get("pane_id") == pane), None)
    if not fresh or fresh.get("state_change_seq") != a.get("state_change_seq") or session_of(fresh) != sid:
        return "changed while summarising"
    tabs = {t["tab_id"]: t for t in herdr("tab", "list")["tabs"]}
    reason, f2 = why_awake(fresh, agents_now(), tabs, manual)
    if reason or f2["pid"] != f["pid"]:
        return reason or "process changed"

    backup = STATE / "transcripts" / f"{sid}.jsonl"  # Claude deletes transcripts untouched for 30 days
    backup.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(f["transcript"], backup)
    last = lambda role: next((t for r, t in reversed(msgs) if r == role), "")
    rec = {"pane_id": pane, "tab_id": a.get("tab_id"), "name": a.get("name"), "cwd": f["cwd"],
           "argv": with_mode(f2["argv"], f2["mode"] or last_permission_mode(f["transcript"])),
           "transcript": str(f["transcript"]), "backup": str(backup),
           "slept_at": datetime.now().strftime("%d.%m %H:%M"), "summary": summary,
           "place": place, "project": project,
           "last_user": last("user")[:2000], "last_assistant": last("assistant")[:4000], "rss_mb": f["rss"]}
    with locked():
        data = load()
        data[sid] = rec
        save(data)

    os.kill(f["pid"], signal.SIGTERM)  # claude exits cleanly on SIGTERM and takes its MCP servers along
    deadline = time.time() + 30
    while alive(f["pid"]) and time.time() < deadline:
        time.sleep(0.5)
    if alive(f["pid"]):
        with locked():
            data = load()
            data.pop(sid, None)
            save(data)
        log(f"kept {a.get('name') or pane}: still running 30 s after SIGTERM")
        return "did not exit after SIGTERM"
    # Herdr ignores a claim made before it has noticed the exit.
    deadline = time.time() + 60
    while time.time() < deadline:
        if not any(x.get("pane_id") == pane and x.get("agent") == "claude" for x in agents_now()):
            break
        time.sleep(1)
    claim(pane, rec)
    if rec["tab_id"]:
        mark_tab(rec["tab_id"])
    show_page(pane, sid)
    log(f"slept {rec['name'] or pane} {sid} after {f['quiet']:.1f} h, ~{f['rss']} MB RSS")
    return None


def forget_awake(agents: list[dict]) -> None:
    """Drop records whose session runs again, however it was woken."""
    live = {session_of(x) for x in agents if x.get("agent") == "claude"}
    with locked():
        data = load()
        woke = [s for s in data if s in live]
        for sid in woke:
            rec = data.pop(sid)
            if rec.get("tab_id"):
                unmark_tab(rec["tab_id"], data, sid)
            log(f"awake again: {rec.get('name') or rec['pane_id']} {sid}")
        if woke:
            save(data)


def sweep(dry_run: bool = False) -> int:
    if CONFIG_ERROR:
        log(f"sleeping is off: {CONFIG_ERROR}")
        print(f"sleeping is off: {CONFIG_ERROR}")
        return 1
    with locked("sweep"):
        agents = agents_now()
        tabs = {t["tab_id"]: t for t in herdr("tab", "list")["tabs"]}
        if not dry_run:
            forget_awake(agents)
        for a in agents:
            name = a.get("name") or a.get("pane_id")
            try:
                if dry_run:
                    reason, f = why_awake(a, agents, tabs)
                    print(f"{name:30} {reason or 'would sleep (~%d MB RSS)' % f['rss']}")
                else:
                    sleep_pane(a, agents, tabs)
            except Exception as exc:  # one pane's failure must not stop the others
                log(f"error on {name}: {exc!r}")
                if dry_run:
                    print(f"{name:30} error {exc!r}")
    return 0


# --- Wake ----------------------------------------------------------------------------------

BOLD, DIM, RESET = "\x1b[1m", "\x1b[2m", "\x1b[0m"
COLORS = {"edit": "32", "write": "32", "bash": "36", "read": "2", "ask": "1;33", "you": "33", "agent": "35",
          "web": "34", "tool": "2"}


def clip(text: str, width: int) -> str:
    return text if len(text) <= width else text[:max(1, width - 1)] + "…"


def wrap(text: str, cols: int, max_lines: int) -> list[str]:
    lines: list[str] = []
    for para in (text or "").splitlines():
        lines += textwrap.wrap(para, cols - 2, initial_indent="  ", subsequent_indent="  ") or [""]
    lines = [ln for i, ln in enumerate(lines) if ln or (i and lines[i - 1])]  # no double blank lines
    while lines and not lines[-1]:
        lines.pop()
    return lines[:max_lines - 1] + ["  …"] if len(lines) > max_lines else lines


def action_lines(actions: list[dict], cols: int) -> list[str]:
    if not actions:
        return []
    day = actions[-1]["when"].strftime("%d.%m")
    out = [f"{BOLD}Останні дії{RESET} {DIM}· {day}{RESET}"]
    for a in actions:
        stamp = a["when"].strftime("%H:%M" if a["when"].strftime("%d.%m") == day else "%d.%m %H:%M")
        text = VERBS.get(a["kind"], "") + ", ".join(a["targets"]) + (f" ×{a['n']}" if a["n"] > 1 else "")
        out.append(f"  {DIM}{stamp}{RESET}  \x1b[{COLORS[a['kind']]}m{a['sym']} "
                   f"{clip(text, cols - len(stamp) - 6)}{RESET}")
    return out


def page_lines(rec: dict, sid: str, actions: list[dict], width: int, rows: int) -> list[str]:
    """The page fitted to the pane: the agent's reply shrinks first, the last actions last."""
    cols = width - 2
    head = [f"{BOLD}{MARK}{rec.get('name') or 'claude'} спить з {rec['slept_at']}{RESET}   {DIM}{rec['cwd']}{RESET}", ""]
    foot = [f"{BOLD}Enter — продовжити з того самого місця{RESET}", f"{DIM}Вручну: {resume_line(rec, sid)}{RESET}"]
    titled = lambda title, body: [f"{BOLD}{title}{RESET}"] + body if body else []
    place = f" {DIM}· {rec['place']}{RESET}" if rec.get("place") else ""
    blocks = {"project": titled("Проєкт" + place, wrap(rec.get("project", ""), cols, 4)),
              "summary": titled("Про що", wrap(rec.get("summary", ""), cols, 6)),
              "actions": action_lines(actions, cols),
              "user": titled("Твоє останнє повідомлення", wrap(rec.get("last_user", ""), cols, 3)),
              "reply": titled("Остання відповідь агента", wrap(rec.get("last_assistant", ""), cols, 10))}
    fixed = sum(len(ANSI.sub("", ln)) // width + 1 for ln in head + foot) + 1  # +1: the cursor line
    for name in ("reply", "user", "summary", "project", "actions"):
        over = sum(len(b) + 1 for b in blocks.values() if b) + fixed - rows
        if over <= 0:
            break
        keep = len(blocks[name]) - over
        blocks[name] = blocks[name][:keep - 1] + ["  …"] if keep >= 3 else []
    lines = head
    for name in ("project", "summary", "actions", "user", "reply"):
        if blocks[name]:
            lines += blocks[name] + [""]
    return lines + foot


def show(rec: dict, sid: str, actions: list[dict]) -> None:
    size = shutil.get_terminal_size()
    subprocess.run(["stty", "sane"], check=False)  # claude may leave the terminal in raw mode
    # Reset attributes, mouse reporting and bracketed paste, show the cursor, clear the screen.
    sys.stdout.write("\x1b[0m\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[?2004l\x1b[?25h\x1b[H\x1b[2J\x1b[3J")
    print("\n".join(page_lines(rec, sid, actions, max(40, min(size.columns, 122)), size.lines)))
    sys.stdout.flush()


def wake_problem(rec: dict, sid: str) -> str | None:
    try:
        agents = agents_now()
    except Exception:
        return "Не вдалося перевірити Herdr. Натисни Enter ще раз."
    other = next((x.get("pane_id") for x in agents if session_of(x) == sid and x.get("agent") == "claude"), None)
    if other:
        return f"Ця розмова вже відкрита в панелі {other}."
    if not os.path.isdir(rec["cwd"]):
        return f"Теки {rec['cwd']} більше немає."
    return None


def page(sid: str) -> int:
    with locked():
        rec = load().get(sid)
    if not rec:
        print(f"herdr-sleep: запису про сесію {sid} немає ({JOURNAL}).")
        return 1
    pane = os.environ.get("HERDR_PANE_ID") or rec["pane_id"]
    try:
        path = Path(rec["transcript"]) if Path(rec["transcript"]).exists() else Path(rec["backup"])
        actions = recent_actions(path, rec["cwd"])
    except Exception:  # the page must show even when the transcript cannot be read
        actions = []
    show(rec, sid, actions)
    signal.signal(signal.SIGWINCH, lambda *_: show(rec, sid, actions))  # refit when the pane is resized
    while True:
        try:
            line = input()
        except (EOFError, KeyboardInterrupt):
            unclaim(pane)
            print(f"\nЛишаю звичайну оболонку. Продовжити вручну:\n  {resume_line(rec, sid)}")
            return 130
        if line.strip():
            print("Текст не надіслано агенту. Натисни Enter без тексту, щоб продовжити.")
            continue
        problem = wake_problem(rec, sid)
        if not problem:
            break
        print(problem)
    if not transcript(sid) and Path(rec["backup"]).exists():
        Path(rec["transcript"]).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(rec["backup"], rec["transcript"])
    unclaim(pane)  # a stale claim would outrank Herdr's own detection of the resumed claude
    tab_id = ((herdr("pane", "get", pane, check=False) or {}).get("pane") or {}).get("tab_id") or rec.get("tab_id")
    with locked():
        unmark_tab(tab_id, load(), sid)
    subprocess.Popen([sys.executable, SELF, "after-wake", pane, sid], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.chdir(rec["cwd"])
    argv = rec["argv"] + ["--resume", sid]
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        print(f"Не вдалося запустити {argv[0]}: {exc}\nВручну: {resume_line(rec, sid)}")
        return 1


def after_wake(pane: str, sid: str) -> int:
    with locked():
        rec = load().get(sid)
    if not rec:
        return 0
    deadline = time.time() + 90
    while time.time() < deadline:
        time.sleep(1)
        a = next((x for x in (herdr("agent", "list", check=False) or {}).get("agents", [])
                  if x.get("pane_id") == pane), None)
        if not a or a.get("agent") != "claude" or session_of(a) != sid:
            continue
        if rec.get("name") and a.get("name") != rec["name"]:
            if herdr("agent", "rename", pane, rec["name"], check=False) is None:
                log(f"woke {sid} but could not rename it back to {rec['name']}")
        with locked():
            data = load()
            data.pop(sid, None)
            save(data)
        log(f"woke {rec.get('name') or pane} {sid}")
        return 0
    log(f"wake of {rec.get('name') or pane} {sid} not confirmed in 90 s; record kept")
    return 1


# --- Lifecycle -----------------------------------------------------------------------------

def rearm() -> None:
    """After a Herdr restart a slept pane is a bare shell again: show its page there once more."""
    with locked():
        data = load()
    agents = {x.get("pane_id"): x for x in agents_now()}
    for sid, rec in data.items():
        pane = rec["pane_id"]
        info = (herdr("pane", "get", pane, check=False) or {}).get("pane")
        if not info or pane in agents:
            continue
        if os.path.realpath(info.get("foreground_cwd") or info.get("cwd") or "/") != rec["cwd"]:
            continue
        fg = ((herdr("pane", "process-info", "--pane", pane, check=False) or {}).get("process_info") or {}) \
            .get("foreground_processes") or []
        if not fg or any(os.path.basename((p.get("argv") or ["?"])[0]).lstrip("-") not in SHELLS for p in fg):
            continue  # something other than a bare shell runs there, or we cannot tell
        claim(pane, rec)
        show_page(pane, sid)
        log(f"re-armed {rec.get('name') or pane} {sid}")


def ensure() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "watcher.lock", "w") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0  # a watcher holds it
    out = open(STATE / "watcher.out", "a")
    subprocess.Popen([sys.executable, SELF, "watch"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=out, stderr=out)
    return 0


def watch() -> int:
    lock = open(STATE / "watcher.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    (STATE / "watcher.pid").write_text(str(os.getpid()))
    log(f"watcher started, idle {IDLE_HOURS} h, every {POLL_SECONDS} s")
    while True:
        try:
            sweep()
        except Exception as exc:
            log(f"sweep failed: {exc!r}")
        time.sleep(POLL_SECONDS)


def refresh() -> int:
    """Redraw every sleeping page with the current code: Ctrl-C ends the old page, re-arm draws the new one."""
    with locked():
        data = load()
    for sid, rec in data.items():
        info = (herdr("pane", "process-info", "--pane", rec["pane_id"], check=False) or {}).get("process_info") or {}
        if any((p.get("argv") or [])[-2:] == ["page", sid] for p in info.get("foreground_processes") or []):
            herdr("pane", "send-keys", rec["pane_id"], "ctrl+c", check=False)  # only our own page, never anything else
    time.sleep(2)
    rearm()
    return 0


def list_sleeping() -> int:
    with locked():
        data = load()
    for sid, rec in data.items():
        print(f"{rec.get('name') or '-':28} {rec['pane_id']:6} з {rec['slept_at']}  {resume_line(rec, sid)}")
    return 0


def main(argv: list[str]) -> int:
    cmd, args = (argv[1], argv[2:]) if len(argv) > 1 else ("", [])
    if cmd == "startup":
        try:
            rearm()
        except Exception as exc:
            log(f"re-arm failed: {exc!r}")
        return ensure()
    if cmd == "ensure":
        return ensure()
    if cmd == "watch":
        return watch()
    if cmd in ("sweep", "preview"):
        return sweep(dry_run=cmd == "preview")
    if cmd == "sleep-pane" and len(args) == 1:
        if CONFIG_ERROR:
            print(f"sleeping is off: {CONFIG_ERROR}")
            return 1
        with locked("sweep"):  # a concurrent sweep's forget_awake would drop the record before claude exits
            agents = agents_now()
            a = next((x for x in agents if x.get("pane_id") == args[0]), None)
            if not a:
                print(f"no agent in pane {args[0]}")
                return 1
            tabs = {t["tab_id"]: t for t in herdr("tab", "list")["tabs"]}
            reason = sleep_pane(a, agents, tabs, manual=True)
        print(reason or "asleep")
        return 1 if reason else 0
    if cmd == "list":
        return list_sleeping()
    if cmd == "refresh":
        return refresh()
    if cmd == "page" and len(args) == 1:
        return page(args[0])
    if cmd == "after-wake" and len(args) == 2:
        return after_wake(*args)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
